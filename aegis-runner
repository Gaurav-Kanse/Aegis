#!/usr/bin/env python3
"""Development launcher for Aegis. Not used in production installs."""
import sys
import os

# Add the repository root to Python path for development use
_repo_root = os.path.dirname(os.path.abspath(__file__))
if _repo_root not in sys.path:
    sys.path.insert(0, _repo_root)

from aegis.main import main

if __name__ == "__main__":
    main()
